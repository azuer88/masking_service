[Unit]
Description=Image Masking Service
Documentation=file:/usr/local/share/doc/masking_service/README.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/masking_service

# Number of worker threads (1-64).
# WARNING: each worker consumes a full CPU core while processing an image.
# Setting this too high on low-powered hardware (e.g. Raspberry Pi) will
# starve OctoPrint and may cause print failures. Start with 1 or 2 on a
# Pi 3/4 and increase only if the hardware can sustain the load.
# Override in a drop-in file:
#   [Service]
#   Environment=MASKING_WORKERS=2
Environment=MASKING_WORKERS=4
Restart=on-failure
RestartSec=3

# Create /run/masking_service/ with mode 0755 owned by the service user.
# The daemon will create its socket inside this directory.
RuntimeDirectory=masking_service
RuntimeDirectoryMode=0755

# Run as the same user as OctoPrint/Octolapse so it has access to all
# snapshot directories and /tmp paths created by those processes.
User=default
Group=default

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=false
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true

# Writable paths required by the service.
# ProtectSystem=strict makes the whole filesystem read-only by default;
# every directory the service needs to write must be listed here.
ReadWritePaths=/tmp

# For paths outside /tmp (e.g. /home/default/octolapse) use a drop-in:
#   /etc/systemd/system/masking_service.service.d/paths.conf
#
#   [Service]
#   ReadWritePaths=/home/default/octolapse

[Install]
WantedBy=multi-user.target
